# Copy to .env and fill in. Never commit the real .env.

# Prisma uses PostgreSQL. Get a free DB from Neon/Supabase/Vercel Postgres.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Pre-launch gate: "true" shows a coming-soon page, "false" reveals the canvas.
NEXT_PUBLIC_COMING_SOON="true"

# Optional password gate (HTTP Basic Auth). Set SITE_PASSWORD to lock the whole
# site behind a login; leave empty/unset to make it public. Username defaults
# to "admin" (override with SITE_AUTH_USER). Remove SITE_PASSWORD at launch.
SITE_PASSWORD=""
SITE_AUTH_USER="admin"

# Solana network. Use "mainnet-beta" for production; a dedicated RPC
# (Helius/QuickNode) is strongly recommended over the public endpoint.
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC="https://api.mainnet-beta.solana.com"

# SPL token mint address.
NEXT_PUBLIC_TOKEN_MINT="MPc3UdXgA6dWS2oqpKck4Mu1FbjfZPTyHS3oFhPiXEL"
# Token decimals — MUST match the actual mint.
NEXT_PUBLIC_TOKEN_DECIMALS="6"

# Local-only: path to the keypair that owns the mint (used by scripts, never shipped).
TOKEN_AUTHORITY_KEYPAIR="./.keys/authority.json"
