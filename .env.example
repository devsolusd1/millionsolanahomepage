# Copy to .env and fill in. Never commit the real .env.

# Prisma uses PostgreSQL. Get a free DB from Neon/Supabase/Vercel Postgres.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Solana network.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"

# SPL token mint — filled automatically by: npm run create-token
NEXT_PUBLIC_TOKEN_MINT=""

# Local-only: path to the keypair that owns the mint (used by scripts, never shipped).
TOKEN_AUTHORITY_KEYPAIR="./.keys/authority.json"
