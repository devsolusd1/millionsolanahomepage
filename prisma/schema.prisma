generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single painted pixel on the canvas. Sparse: only painted pixels exist.
model Pixel {
  x         Int
  y         Int
  // Color stored as #rrggbb hex string.
  color     String
  // Wallet that painted it (base58 pubkey).
  owner     String
  // Burn transaction signature that paid for this pixel.
  txSig     String
  updatedAt DateTime @updatedAt

  @@id([x, y])
  @@index([owner])
}

// A verified burn that reserves a rectangular region of the canvas.
// The whole region is owned (and paid for) even if not fully painted.
model BurnTx {
  signature      String   @id
  wallet         String
  // Total tokens burned in this tx (== region area * TOKENS_PER_PIXEL).
  amount         Int
  // Reserved region rectangle.
  rx             Int
  ry             Int
  rw             Int
  rh             Int
  // Region area in pixels (rw * rh).
  pixelsClaimed  Int
  // Display name of the creator (required for new placements; older rows may be null).
  creator        String?
  // Optional URL the region links to (http/https only).
  link           String?
  createdAt      DateTime @default(now())

  @@index([wallet])
}
